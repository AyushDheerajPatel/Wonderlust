<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h1>Update Your Listing</h1>
   <form method="post" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">
    <div class="md-3">
        <label for="title" class="form-label">Title:</label>
        <input type="text" id="title"  class="form-control"  value="<%= listing.title %> " name="listing[title]" required>
        <div class="invalid-feedback">Please provide a title.</div>
        <div class="valid-feedback">Looks good!</div>
    </div>
    <div class="md-3">
        <label for="description" class="form-label">Description:</label>
        <textarea id="description"  class="form-control"  name="listing[description]" required><%= listing.description %></textarea>
        <div class="invalid-feedback">Please provide a description.</div>
        <div class="valid-feedback">Nice description!</div>
    </div>
    <div class="mb-3">
        Original Image:
        <img src="<%= originalImage %>" alt="Original Image">
    </div>
    <div class="md-3">
       <label for="image" class="form-label"> Upload New Image:</label>
       <input type="file" name="listing[image]" id="image" class="form-control">
       <div class="valid-feedback">Looks good!</div>
    </div>
    <div class="row">
        <div class="md-3 col-md-4">
            <label for="price" class="form-label">Price:</label>
            <input type="number" id="price" class="form-control" value="<%=listing.price %>" name="listing[price]" required>
            <div class="invalid-feedback">Please provide a valid price.</div>
        </div>
        <div class="md-3 col-md-8">
              <label for="country" class="form-label" >Country:</label>
            <input type="text" id="country" class="form-control" value="<%= listing.country %>" name="listing[country]" required>
            <div class="invalid-feedback">Please provide a valid country.</div>
        </div>
    </div>
    <div class="md-3">
       <label for="location" class="form-label" >Location:</label>
       <input type="text" id="location" class="form-control" value="<%= listing.location %>" name="listing[location]" required>
       <div class="invalid-feedback">Please provide a valid location.</div>
    </div>
       <button type="submit" class="btn btn-dark edit-btn mt-3 mb-3">Update Listing</button>
   </form>
  
   </div>
</div>   

